---
import BaseLayout from '../layouts/BaseLayout.astro';

type Phoneme = {
  ipa: string;
  word: string;
  transcription: string;
  hint: string;
  family: string;
};

type PhonemeSection = {
  id: 'monophthongs' | 'diphthongs' | 'consonants';
  eyebrow: string;
  title: string;
  description: string;
  kind: 'vowels' | 'consonants';
  phonemes: Phoneme[];
};

const sections: PhonemeSection[] = [
  {
    id: 'monophthongs',
    eyebrow: '01 · VOWELS',
    title: '单元音',
    description: '发音过程中口型基本保持不变，先听清长短与舌位。',
    kind: 'vowels',
    phonemes: [
      { ipa: 'iː', word: 'sheep', transcription: '/ʃiːp/', hint: '长“衣”音', family: '长元音' },
      { ipa: 'ɪ', word: 'ship', transcription: '/ʃɪp/', hint: '短“衣”音', family: '短元音' },
      { ipa: 'e', word: 'bed', transcription: '/bed/', hint: '短“诶”音', family: '短元音' },
      { ipa: 'æ', word: 'cat', transcription: '/kæt/', hint: '嘴角展开', family: '短元音' },
      { ipa: 'ɑː', word: 'car', transcription: '/kɑː/', hint: '长“啊”音', family: '长元音' },
      { ipa: 'ɒ', word: 'hot', transcription: '/hɒt/', hint: '短“哦”音', family: '短元音' },
      { ipa: 'ɔː', word: 'talk', transcription: '/tɔːk/', hint: '长“哦”音', family: '长元音' },
      { ipa: 'ʊ', word: 'book', transcription: '/bʊk/', hint: '短“乌”音', family: '短元音' },
      { ipa: 'uː', word: 'moon', transcription: '/muːn/', hint: '长“乌”音', family: '长元音' },
      { ipa: 'ʌ', word: 'cup', transcription: '/kʌp/', hint: '短“啊”音', family: '短元音' },
      { ipa: 'ɜː', word: 'bird', transcription: '/bɜːd/', hint: '舌位居中', family: '长元音' },
      { ipa: 'ə', word: 'about', transcription: '/əˈbaʊt/', hint: '轻声央元音', family: '短元音' },
    ],
  },
  {
    id: 'diphthongs',
    eyebrow: '02 · VOWEL GLIDES',
    title: '双元音',
    description: '由一个元音自然滑向另一个元音，注意口型移动要连贯。',
    kind: 'vowels',
    phonemes: [
      { ipa: 'eɪ', word: 'face', transcription: '/feɪs/', hint: 'e 滑向 ɪ', family: '双元音' },
      { ipa: 'aɪ', word: 'time', transcription: '/taɪm/', hint: 'a 滑向 ɪ', family: '双元音' },
      { ipa: 'ɔɪ', word: 'boy', transcription: '/bɔɪ/', hint: 'ɔ 滑向 ɪ', family: '双元音' },
      { ipa: 'əʊ', word: 'home', transcription: '/həʊm/', hint: 'ə 滑向 ʊ', family: '双元音' },
      { ipa: 'aʊ', word: 'now', transcription: '/naʊ/', hint: 'a 滑向 ʊ', family: '双元音' },
      { ipa: 'ɪə', word: 'near', transcription: '/nɪə/', hint: 'ɪ 滑向 ə', family: '双元音' },
      { ipa: 'eə', word: 'hair', transcription: '/heə/', hint: 'e 滑向 ə', family: '双元音' },
      { ipa: 'ʊə', word: 'tour', transcription: '/tʊə/', hint: 'ʊ 滑向 ə', family: '双元音' },
    ],
  },
  {
    id: 'consonants',
    eyebrow: '03 · CONSONANTS',
    title: '辅音',
    description: '留意声带是否振动，以及气流在唇、齿和舌之间受到的阻碍。',
    kind: 'consonants',
    phonemes: [
      { ipa: 'p', word: 'pen', transcription: '/pen/', hint: '双唇送气', family: '爆破音' },
      { ipa: 'b', word: 'book', transcription: '/bʊk/', hint: '双唇振动', family: '爆破音' },
      { ipa: 't', word: 'tea', transcription: '/tiː/', hint: '舌尖送气', family: '爆破音' },
      { ipa: 'd', word: 'dog', transcription: '/dɒɡ/', hint: '舌尖振动', family: '爆破音' },
      { ipa: 'k', word: 'key', transcription: '/kiː/', hint: '舌后送气', family: '爆破音' },
      { ipa: 'ɡ', word: 'game', transcription: '/ɡeɪm/', hint: '舌后振动', family: '爆破音' },
      { ipa: 'f', word: 'fish', transcription: '/fɪʃ/', hint: '上齿轻触下唇', family: '摩擦音' },
      { ipa: 'v', word: 'voice', transcription: '/vɔɪs/', hint: '唇齿振动', family: '摩擦音' },
      { ipa: 'θ', word: 'think', transcription: '/θɪŋk/', hint: '舌尖轻触齿间', family: '摩擦音' },
      { ipa: 'ð', word: 'this', transcription: '/ðɪs/', hint: '齿间振动', family: '摩擦音' },
      { ipa: 's', word: 'sun', transcription: '/sʌn/', hint: '清晰送气', family: '摩擦音' },
      { ipa: 'z', word: 'zoo', transcription: '/zuː/', hint: '声带振动', family: '摩擦音' },
      { ipa: 'ʃ', word: 'she', transcription: '/ʃiː/', hint: '类似“嘘”', family: '摩擦音' },
      { ipa: 'ʒ', word: 'vision', transcription: '/ˈvɪʒən/', hint: 'ʃ 的浊音', family: '摩擦音' },
      { ipa: 'h', word: 'hat', transcription: '/hæt/', hint: '喉部送气', family: '摩擦音' },
      { ipa: 'r', word: 'red', transcription: '/red/', hint: '舌尖不触上颚', family: '摩擦音' },
      { ipa: 'tʃ', word: 'chair', transcription: '/tʃeə/', hint: '类似“吃”', family: '破擦音' },
      { ipa: 'dʒ', word: 'jump', transcription: '/dʒʌmp/', hint: '类似“知”', family: '破擦音' },
      { ipa: 'tr', word: 'tree', transcription: '/triː/', hint: 't 与 r 连读', family: '破擦音' },
      { ipa: 'dr', word: 'dream', transcription: '/driːm/', hint: 'd 与 r 连读', family: '破擦音' },
      { ipa: 'ts', word: 'cats', transcription: '/kæts/', hint: '类似“次”', family: '破擦音' },
      { ipa: 'dz', word: 'beds', transcription: '/bedz/', hint: 'ts 的浊音', family: '破擦音' },
      { ipa: 'm', word: 'map', transcription: '/mæp/', hint: '双唇鼻音', family: '鼻音' },
      { ipa: 'n', word: 'nose', transcription: '/nəʊz/', hint: '舌尖鼻音', family: '鼻音' },
      { ipa: 'ŋ', word: 'sing', transcription: '/sɪŋ/', hint: '舌后鼻音', family: '鼻音' },
      { ipa: 'l', word: 'leg', transcription: '/leɡ/', hint: '舌尖抵上齿龈', family: '舌边音' },
      { ipa: 'j', word: 'yes', transcription: '/jes/', hint: '类似短“耶”', family: '半元音' },
      { ipa: 'w', word: 'water', transcription: '/ˈwɔːtə/', hint: '双唇收圆', family: '半元音' },
    ],
  },
];
---

<BaseLayout title="英语音标发音练习 · KiteAidan" description="48 个英语国际音标互动发音表，点击音标听示例词发音。">
  <main class="phonetics-page">
    <section class="phonetics-hero">
      <div class="sound-orbit" aria-hidden="true">
        <span class="orbit-symbol orbit-symbol--one">θ</span>
        <span class="orbit-symbol orbit-symbol--two">æ</span>
        <span class="orbit-symbol orbit-symbol--three">ʒ</span>
        <span class="orbit-core">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 9v6h4l5 4V5l-5 4H8Z"></path><path class="wave" d="M20 9.5c.7.7 1 1.5 1 2.5s-.3 1.8-1 2.5"></path></svg>
        </span>
      </div>
      <div class="hero-copy">
        <p class="kicker"><span></span> INTERACTIVE IPA LAB</p>
        <h1>听见每一个<br /><em>英语音标</em></h1>
        <p class="hero-intro">48 个常用英语国际音标。点击任意卡片，听示例词、辨别口型，再开口模仿。</p>
        <div class="hero-stats" aria-label="音标数量统计">
          <div><strong>20</strong><span>元音</span></div>
          <div><strong>28</strong><span>辅音</span></div>
          <div><strong>48</strong><span>全部音标</span></div>
        </div>
      </div>
    </section>

    <section class="practice-panel" aria-label="发音控制">
      <div class="practice-status">
        <span class="status-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M6 10v4h3l4 3V7l-4 3H6Z"></path><path d="M16 9.5c.7.7 1 1.5 1 2.5s-.3 1.8-1 2.5"></path></svg>
        </span>
        <div>
          <span class="status-label">当前发音</span>
          <strong id="speech-status" aria-live="polite">点击下方任意音标开始</strong>
        </div>
      </div>
      <div class="practice-controls">
        <div class="segmented" aria-label="显示分类">
          <button class="filter-button active" type="button" data-filter="all" aria-pressed="true">全部</button>
          <button class="filter-button" type="button" data-filter="vowels" aria-pressed="false">元音</button>
          <button class="filter-button" type="button" data-filter="consonants" aria-pressed="false">辅音</button>
        </div>
        <label class="select-wrap">
          <span>口音</span>
          <select id="accent-select" aria-label="选择发音口音">
            <option value="en-GB">英音</option>
            <option value="en-US">美音</option>
          </select>
        </label>
        <label class="select-wrap">
          <span>语速</span>
          <select id="speed-select" aria-label="选择发音速度">
            <option value="0.72">慢速</option>
            <option value="0.92" selected>正常</option>
          </select>
        </label>
      </div>
    </section>

    <div class="phoneme-sections">
      {sections.map((section) => (
        <section class="phoneme-section" id={section.id} data-kind={section.kind}>
          <header class="section-heading">
            <div>
              <p>{section.eyebrow}</p>
              <h2>{section.title}<sup>{section.phonemes.length}</sup></h2>
            </div>
            <p class="section-description">{section.description}</p>
          </header>

          <div class="phoneme-grid">
            {section.phonemes.map((phoneme) => (
              <button
                class="phoneme-card"
                type="button"
                data-word={phoneme.word}
                data-ipa={phoneme.ipa}
                aria-label={`播放音标 ${phoneme.ipa}，示例词 ${phoneme.word}`}
              >
                <span class="card-topline">
                  <span class="family">{phoneme.family}</span>
                  <span class="play-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5V7Z"></path></svg>
                  </span>
                </span>
                <strong class="ipa">/{phoneme.ipa}/</strong>
                <span class="example">
                  <span class="word">{phoneme.word}</span>
                  <span class="transcription">{phoneme.transcription}</span>
                </span>
                <span class="hint">{phoneme.hint}</span>
                <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              </button>
            ))}
          </div>
        </section>
      ))}
    </div>

    <aside class="learning-note">
      <span class="note-number">TIP / 01</span>
      <div>
        <h2>听音标，也要听它在单词里的样子</h2>
        <p>孤立的音标容易失真，所以每次点击会播放一个包含目标音的示例词。先慢速听两遍，再跟读并录下自己的声音作比较。</p>
      </div>
    </aside>
  </main>

  <script>
    const speechStatus = document.querySelector<HTMLElement>('#speech-status');
    const accentSelect = document.querySelector<HTMLSelectElement>('#accent-select');
    const speedSelect = document.querySelector<HTMLSelectElement>('#speed-select');
    const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.phoneme-card'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-button'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.phoneme-section'));
    let voices: SpeechSynthesisVoice[] = [];
    let activeCard: HTMLButtonElement | null = null;

    const loadVoices = () => {
      if ('speechSynthesis' in window) voices = window.speechSynthesis.getVoices();
    };

    loadVoices();
    if ('speechSynthesis' in window) window.speechSynthesis.addEventListener('voiceschanged', loadVoices);

    const stopPlayback = () => {
      if ('speechSynthesis' in window) window.speechSynthesis.cancel();
      activeCard?.classList.remove('playing');
      activeCard = null;
    };

    const speak = (card: HTMLButtonElement) => {
      const word = card.dataset.word ?? '';
      const ipa = card.dataset.ipa ?? '';

      if (!('speechSynthesis' in window)) {
        if (speechStatus) speechStatus.textContent = '当前浏览器不支持语音播放';
        return;
      }

      stopPlayback();
      const accent = accentSelect?.value ?? 'en-GB';
      const utterance = new SpeechSynthesisUtterance(word);
      utterance.lang = accent;
      utterance.rate = Number(speedSelect?.value ?? 0.92);
      const matchingVoices = voices.filter((voice) => voice.lang.toLowerCase().startsWith(accent.toLowerCase()));
      const preferredVoice = matchingVoices.find((voice) => /natural|premium|google|samantha|daniel/i.test(voice.name));
      utterance.voice = preferredVoice ?? matchingVoices[0] ?? null;

      activeCard = card;
      card.classList.add('playing');
      if (speechStatus) speechStatus.textContent = `/${ipa}/ · ${word}`;

      utterance.onend = () => {
        card.classList.remove('playing');
        if (activeCard === card) activeCard = null;
      };
      utterance.onerror = () => {
        card.classList.remove('playing');
        if (speechStatus) speechStatus.textContent = '播放失败，请检查设备声音设置';
        if (activeCard === card) activeCard = null;
      };

      window.speechSynthesis.speak(utterance);
    };

    cards.forEach((card) => card.addEventListener('click', () => speak(card)));

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        filterButtons.forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        sections.forEach((section) => {
          section.hidden = filter !== 'all' && section.dataset.kind !== filter;
        });
      });
    });

    window.addEventListener('pagehide', stopPlayback);
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #0b100f;
  }

  :global(.site-nav) {
    background: rgba(11, 16, 15, 0.88);
  }

  :global(footer.site-footer) {
    background: #0b100f;
  }

  .phonetics-page {
    --mint: #a7f3d0;
    --mint-strong: #58d6a7;
    --mint-soft: rgba(88, 214, 167, 0.12);
    --panel: #111817;
    --panel-high: #16201e;
    --line: rgba(210, 255, 239, 0.1);
    --secondary: #9aa9a4;
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 9.5rem 0 3rem;
  }

  .phonetics-hero {
    min-height: 455px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    align-items: center;
    gap: 5rem;
    padding-bottom: 5.5rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-copy {
    order: -1;
    max-width: 720px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.6rem;
    color: var(--mint-strong);
    font: 600 0.72rem/1 var(--font-mono);
    letter-spacing: 0.16em;
  }

  .kicker span {
    width: 28px;
    height: 1px;
    background: var(--mint-strong);
  }

  .phonetics-hero h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3.8rem, 8vw, 7.2rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.055em;
    color: #edf8f3;
  }

  .phonetics-hero h1 em {
    color: var(--mint);
    font-weight: 400;
  }

  .hero-intro {
    max-width: 560px;
    margin-top: 2rem;
    color: var(--secondary);
    font-size: 1.03rem;
    line-height: 1.8;
  }

  .hero-stats {
    display: flex;
    gap: 2.8rem;
    margin-top: 2.6rem;
  }

  .hero-stats div {
    display: grid;
    gap: 0.18rem;
  }

  .hero-stats strong {
    color: #f3fbf8;
    font: 500 1.35rem/1 var(--font-mono);
  }

  .hero-stats span {
    color: #72827d;
    font-size: 0.76rem;
  }

  .sound-orbit {
    position: relative;
    width: 330px;
    aspect-ratio: 1;
    justify-self: center;
    border: 1px solid rgba(167, 243, 208, 0.16);
    border-radius: 50%;
  }

  .sound-orbit::before,
  .sound-orbit::after {
    content: '';
    position: absolute;
    inset: 42px;
    border: 1px solid rgba(167, 243, 208, 0.11);
    border-radius: 50%;
  }

  .sound-orbit::after {
    inset: 88px;
    background: radial-gradient(circle, rgba(88, 214, 167, 0.12), transparent 68%);
  }

  .orbit-core {
    position: absolute;
    inset: 50%;
    z-index: 2;
    width: 88px;
    height: 88px;
    display: grid;
    place-items: center;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(167, 243, 208, 0.34);
    border-radius: 50%;
    color: var(--mint);
    background: rgba(12, 23, 20, 0.9);
    box-shadow: 0 0 70px rgba(88, 214, 167, 0.15);
  }

  .orbit-core svg {
    width: 32px;
    fill: currentColor;
  }

  .orbit-core .wave {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .orbit-symbol {
    position: absolute;
    z-index: 3;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--panel);
    color: #c5d9d2;
    font: 500 1.1rem/1 var(--font-serif);
  }

  .orbit-symbol--one { top: 25px; left: 57px; }
  .orbit-symbol--two { top: 89px; right: -7px; }
  .orbit-symbol--three { bottom: 6px; left: 83px; }

  .practice-panel {
    position: sticky;
    top: 68px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin: -1px 0 5rem;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--line);
    border-top: 0;
    background: rgba(17, 24, 23, 0.93);
    backdrop-filter: blur(16px);
  }

  .practice-status,
  .practice-controls,
  .segmented,
  .select-wrap {
    display: flex;
    align-items: center;
  }

  .practice-status { gap: 0.75rem; min-width: 250px; }

  .status-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--mint-soft);
    color: var(--mint);
  }

  .status-icon svg {
    width: 22px;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .practice-status div { display: grid; gap: 0.05rem; }
  .status-label { color: #71817c; font-size: 0.67rem; letter-spacing: 0.08em; }
  #speech-status { color: #dce9e4; font-size: 0.84rem; font-weight: 500; }
  .practice-controls { gap: 1rem; }

  .segmented {
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .filter-button {
    padding: 0.4rem 0.78rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #83938e;
    font: inherit;
    font-size: 0.76rem;
    cursor: pointer;
  }

  .filter-button.active {
    background: #dffbef;
    color: #12201c;
  }

  .select-wrap {
    gap: 0.45rem;
    color: #71817c;
    font-size: 0.72rem;
  }

  .select-wrap select {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.42rem 1.6rem 0.42rem 0.58rem;
    background: #151e1c;
    color: #dce9e4;
    font: inherit;
    font-size: 0.76rem;
  }

  .phoneme-sections {
    display: grid;
    gap: 6.5rem;
  }

  .phoneme-section[hidden] { display: none; }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 420px);
    align-items: end;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  .section-heading > div > p {
    margin-bottom: 0.65rem;
    color: var(--mint-strong);
    font: 600 0.68rem/1 var(--font-mono);
    letter-spacing: 0.15em;
  }

  .section-heading h2 {
    color: #edf8f3;
    font: 500 clamp(2.3rem, 4.5vw, 3.5rem)/1 var(--font-serif);
    letter-spacing: -0.035em;
  }

  .section-heading sup {
    margin-left: 0.4rem;
    color: #60716b;
    font: 400 0.8rem/1 var(--font-mono);
    vertical-align: top;
  }

  .section-description {
    padding-bottom: 0.15rem;
    color: var(--secondary);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .phoneme-grid {
    display: grid;
