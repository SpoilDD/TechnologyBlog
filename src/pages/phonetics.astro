---
import BaseLayout from '../layouts/BaseLayout.astro';
import phonemeData from '../data/phonemes.json';
import phonemeAudioData from '../data/phoneme-audio-resolved.json';

type Phoneme = {
  id: string;
  ipa: string;
  word: string;
  transcription: string;
  hint: string;
  family: string;
};

type AudioSource = {
  file: string;
  url: string;
  sourcePage: string;
  sample: 'ipa' | 'word';
  sampleLabel: string | null;
};

type PhonemeSection = {
  id: 'monophthongs' | 'diphthongs' | 'consonants';
  eyebrow: string;
  title: string;
  description: string;
  kind: 'vowels' | 'consonants';
  phonemes: Phoneme[];
};

const sections = phonemeData as PhonemeSection[];
const audioSources = phonemeAudioData as Record<string, AudioSource>;
---

<BaseLayout title="英语音标发音练习 · KiteAidan" description="48 个英语国际音标互动发音表，点击音标听单独发音。">
  <main class="phonetics-page">
    <section class="phonetics-hero">
      <div class="sound-orbit" aria-hidden="true">
        <span class="orbit-symbol orbit-symbol--one">θ</span>
        <span class="orbit-symbol orbit-symbol--two">æ</span>
        <span class="orbit-symbol orbit-symbol--three">ʒ</span>
        <span class="orbit-core">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 9v6h4l5 4V5l-5 4H8Z"></path><path class="wave" d="M20 9.5c.7.7 1 1.5 1 2.5s-.3 1.8-1 2.5"></path></svg>
        </span>
      </div>
      <div class="hero-copy">
        <p class="kicker"><span></span> INTERACTIVE IPA LAB</p>
        <h1>听见每一个<br /><em>英语音标</em></h1>
        <p class="hero-intro">48 个常用英语国际音标。点击任意卡片，先听清晰的独立音素，再听浏览器朗读示例单词。</p>
        <div class="hero-stats" aria-label="音标数量统计">
          <div><strong>20</strong><span>元音</span></div>
          <div><strong>28</strong><span>辅音</span></div>
          <div><strong>48</strong><span>全部音标</span></div>
        </div>
      </div>
    </section>

    <section class="practice-panel" aria-label="发音控制">
      <div class="practice-status">
        <span class="status-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M6 10v4h3l4 3V7l-4 3H6Z"></path><path d="M16 9.5c.7.7 1 1.5 1 2.5s-.3 1.8-1 2.5"></path></svg>
        </span>
        <div>
          <span class="status-label">当前发音</span>
          <strong id="speech-status" aria-live="polite">点击下方任意音标开始</strong>
        </div>
      </div>
      <div class="practice-controls">
        <div class="segmented" aria-label="显示分类">
          <button class="filter-button active" type="button" data-filter="all" aria-pressed="true">全部</button>
          <button class="filter-button" type="button" data-filter="vowels" aria-pressed="false">元音</button>
          <button class="filter-button" type="button" data-filter="consonants" aria-pressed="false">辅音</button>
        </div>
        <label class="select-wrap">
          <span>语速</span>
          <select id="speed-select" aria-label="选择发音速度">
            <option value="0.75">慢速</option>
            <option value="1" selected>正常</option>
          </select>
        </label>
        <a class="credit-link" href="/audio/phonetics/attribution.html" target="_blank" rel="noreferrer">来源与许可</a>
      </div>
    </section>

    <div class="phoneme-sections">
      {sections.map((section) => (
        <section class="phoneme-section" id={section.id} data-kind={section.kind}>
          <header class="section-heading">
            <div>
              <p>{section.eyebrow}</p>
              <h2>{section.title}<sup>{section.phonemes.length}</sup></h2>
            </div>
            <p class="section-description">{section.description}</p>
          </header>

          <div class="phoneme-grid">
            {section.phonemes.map((phoneme) => (
              <button
                class="phoneme-card"
                type="button"
                data-ipa={phoneme.ipa}
                data-word={phoneme.word}
                data-audio-src={section.kind === 'consonants' ? `/audio/phonetics/en-GB/${phoneme.id}.wav` : audioSources[phoneme.id].url}
                data-sample-label={section.kind === 'consonants' ? '本地独立辅音' : audioSources[phoneme.id].sample === 'word' ? `真人示例词 ${audioSources[phoneme.id].sampleLabel}` : 'Wikimedia 真人 IPA 示例'}
                aria-label={`播放音标 ${phoneme.ipa} 和示例词 ${phoneme.word}`}
              >
                <span class="card-topline">
                  <span class="family">{phoneme.family}</span>
                  <span class="play-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="m9 7 8 5-8 5V7Z"></path></svg>
                  </span>
                </span>
                <strong class="ipa">/{phoneme.ipa}/</strong>
                <span class="example">
                  <span class="word">{phoneme.word}</span>
                  <span class="transcription">{phoneme.transcription}</span>
                </span>
                <span class="hint">{phoneme.hint}</span>
                <span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              </button>
            ))}
          </div>
        </section>
      ))}
    </div>

    <aside class="learning-note">
      <span class="note-number">TIP / 01</span>
      <div>
        <h2>先听单独音标，再对照示例词</h2>
        <p>每次点击会先播放独立音素，结束后再用浏览器语音朗读卡片上的示例词。元音采用 Wikimedia Commons 真人录音；辅音采用原来的本地独立短音，避免语言学示范录音中的 “a–辅音–a” 连读。</p>
      </div>
    </aside>
  </main>

  <script>
    const speechStatus = document.querySelector<HTMLElement>('#speech-status');
    const speedSelect = document.querySelector<HTMLSelectElement>('#speed-select');
    const cards = Array.from(document.querySelectorAll<HTMLButtonElement>('.phoneme-card'));
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-button'));
    const sections = Array.from(document.querySelectorAll<HTMLElement>('.phoneme-section'));
    let activeCard: HTMLButtonElement | null = null;
    let activeAudio: HTMLAudioElement | null = null;
    let activeUtterance: SpeechSynthesisUtterance | null = null;
    let wordTimer: number | null = null;

    const stopPlayback = () => {
      if (activeAudio) {
        activeAudio.pause();
        activeAudio.removeAttribute('src');
        activeAudio = null;
      }
      window.speechSynthesis?.cancel();
      activeUtterance = null;
      if (wordTimer !== null) window.clearTimeout(wordTimer);
      wordTimer = null;
      activeCard?.classList.remove('playing');
      activeCard = null;
    };

    const finishPlayback = (card: HTMLButtonElement) => {
      card.classList.remove('playing');
      if (activeCard === card) activeCard = null;
    };

    const speakExampleWord = (card: HTMLButtonElement, ipa: string, word: string) => {
      if (!('speechSynthesis' in window) || !word) {
        finishPlayback(card);
        if (speechStatus) speechStatus.textContent = `/${ipa}/ 播放完成 · 当前浏览器不支持单词朗读`;
        return;
      }

      const utterance = new SpeechSynthesisUtterance(word);
      const voices = window.speechSynthesis.getVoices();
      utterance.voice = voices.find((voice) => voice.lang.toLowerCase() === 'en-gb')
        ?? voices.find((voice) => voice.lang.toLowerCase().startsWith('en'))
        ?? null;
      utterance.lang = utterance.voice?.lang ?? 'en-GB';
      utterance.rate = Number(speedSelect?.value ?? 1);
      utterance.pitch = 1;
      activeUtterance = utterance;
      utterance.onstart = () => {
        if (activeUtterance === utterance && speechStatus) speechStatus.textContent = `${word} · 浏览器朗读示例词`;
      };
      utterance.onend = () => {
        if (activeUtterance !== utterance) return;
        activeUtterance = null;
        finishPlayback(card);
        if (speechStatus) speechStatus.textContent = `/${ipa}/ → ${word} · 播放完成`;
      };
      utterance.onerror = () => {
        if (activeUtterance !== utterance) return;
        activeUtterance = null;
        finishPlayback(card);
        if (speechStatus) speechStatus.textContent = `/${ipa}/ 已播放 · 示例词朗读失败`;
      };
      window.speechSynthesis.speak(utterance);
    };

    const playPhoneme = (card: HTMLButtonElement) => {
      const ipa = card.dataset.ipa ?? '';
      const word = card.dataset.word ?? '';
      const audioSrc = card.dataset.audioSrc ?? '';
      const sampleLabel = card.dataset.sampleLabel ?? '真人 IPA 示例';
      stopPlayback();
      activeCard = card;
      card.classList.add('playing');
      if (speechStatus) speechStatus.textContent = `正在加载 /${ipa}/ · Wikimedia 真人录音`;

      const audio = new Audio(audioSrc);
      let failed = false;
      activeAudio = audio;
      audio.preload = 'auto';
      audio.playbackRate = Number(speedSelect?.value ?? 1);
      audio.preservesPitch = true;
      audio.onplaying = () => {
        if (activeAudio === audio && speechStatus) speechStatus.textContent = `/${ipa}/ · ${sampleLabel}`;
      };
      audio.onended = () => {
        if (activeAudio === audio) activeAudio = null;
        if (activeCard !== card) return;
        if (speechStatus) speechStatus.textContent = `/${ipa}/ · 接下来朗读 ${word}`;
        wordTimer = window.setTimeout(() => {
          wordTimer = null;
          if (activeCard === card) speakExampleWord(card, ipa, word);
        }, 400);
      };
      const showAudioError = () => {
        if (failed || activeAudio !== audio) return;
        failed = true;
        audio.pause();
        activeAudio = null;
        finishPlayback(card);
        if (speechStatus) speechStatus.textContent = `/${ipa}/ 音频不可用 · 请先下载 Wikimedia 音频`;
      };
      audio.onerror = showAudioError;
      audio.play().catch(showAudioError);
    };

    cards.forEach((card) => card.addEventListener('click', () => playPhoneme(card)));

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter ?? 'all';
        filterButtons.forEach((item) => {
          const selected = item === button;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-pressed', String(selected));
        });
        sections.forEach((section) => {
          section.hidden = filter !== 'all' && section.dataset.kind !== filter;
        });
      });
    });

    window.addEventListener('pagehide', stopPlayback);
  </script>
</BaseLayout>

<style>
  :global(body) {
    background: #0b100f;
  }

  :global(.site-nav) {
    background: rgba(11, 16, 15, 0.88);
  }

  :global(footer.site-footer) {
    background: #0b100f;
  }

  .phonetics-page {
    --mint: #a7f3d0;
    --mint-strong: #58d6a7;
    --mint-soft: rgba(88, 214, 167, 0.12);
    --panel: #111817;
    --panel-high: #16201e;
    --line: rgba(210, 255, 239, 0.1);
    --secondary: #9aa9a4;
    width: min(1180px, calc(100% - 3rem));
    margin: 0 auto;
    padding: 9.5rem 0 3rem;
  }

  .phonetics-hero {
    min-height: 455px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 390px;
    align-items: center;
    gap: 5rem;
    padding-bottom: 5.5rem;
    border-bottom: 1px solid var(--line);
  }

  .hero-copy {
    order: -1;
    max-width: 720px;
  }

  .kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.6rem;
    color: var(--mint-strong);
    font: 600 0.72rem/1 var(--font-mono);
    letter-spacing: 0.16em;
  }

  .kicker span {
    width: 28px;
    height: 1px;
    background: var(--mint-strong);
  }

  .phonetics-hero h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(3.8rem, 8vw, 7.2rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.055em;
    color: #edf8f3;
  }

  .phonetics-hero h1 em {
    color: var(--mint);
    font-weight: 400;
  }

  .hero-intro {
    max-width: 560px;
    margin-top: 2rem;
    color: var(--secondary);
    font-size: 1.03rem;
    line-height: 1.8;
  }

  .hero-stats {
    display: flex;
    gap: 2.8rem;
    margin-top: 2.6rem;
  }

  .hero-stats div {
    display: grid;
    gap: 0.18rem;
  }

  .hero-stats strong {
    color: #f3fbf8;
    font: 500 1.35rem/1 var(--font-mono);
  }

  .hero-stats span {
    color: #72827d;
    font-size: 0.76rem;
  }

  .sound-orbit {
    position: relative;
    width: 330px;
    aspect-ratio: 1;
    justify-self: center;
    border: 1px solid rgba(167, 243, 208, 0.16);
    border-radius: 50%;
  }

  .sound-orbit::before,
  .sound-orbit::after {
    content: '';
    position: absolute;
    inset: 42px;
    border: 1px solid rgba(167, 243, 208, 0.11);
    border-radius: 50%;
  }

  .sound-orbit::after {
    inset: 88px;
    background: radial-gradient(circle, rgba(88, 214, 167, 0.12), transparent 68%);
  }

  .orbit-core {
    position: absolute;
    inset: 50%;
    z-index: 2;
    width: 88px;
    height: 88px;
    display: grid;
    place-items: center;
    transform: translate(-50%, -50%);
    border: 1px solid rgba(167, 243, 208, 0.34);
    border-radius: 50%;
    color: var(--mint);
    background: rgba(12, 23, 20, 0.9);
    box-shadow: 0 0 70px rgba(88, 214, 167, 0.15);
  }

  .orbit-core svg {
    width: 32px;
    fill: currentColor;
  }

  .orbit-core .wave {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .orbit-symbol {
    position: absolute;
    z-index: 3;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--panel);
    color: #c5d9d2;
    font: 500 1.1rem/1 var(--font-serif);
  }

  .orbit-symbol--one { top: 25px; left: 57px; }
  .orbit-symbol--two { top: 89px; right: -7px; }
  .orbit-symbol--three { bottom: 6px; left: 83px; }

  .practice-panel {
    position: sticky;
    top: 68px;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin: -1px 0 5rem;
    padding: 1.15rem 1.3rem;
    border: 1px solid var(--line);
    border-top: 0;
    background: rgba(17, 24, 23, 0.93);
    backdrop-filter: blur(16px);
  }

  .practice-status,
  .practice-controls,
  .segmented,
  .select-wrap {
    display: flex;
    align-items: center;
  }

  .practice-status { gap: 0.75rem; min-width: 250px; }

  .status-icon {
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--mint-soft);
    color: var(--mint);
  }

  .status-icon svg {
    width: 22px;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .practice-status div { display: grid; gap: 0.05rem; }
  .status-label { color: #71817c; font-size: 0.67rem; letter-spacing: 0.08em; }
  #speech-status { color: #dce9e4; font-size: 0.84rem; font-weight: 500; }
  .practice-controls { gap: 1rem; }

  .segmented {
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .filter-button {
    padding: 0.4rem 0.78rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #83938e;
    font: inherit;
    font-size: 0.76rem;
    cursor: pointer;
  }

  .filter-button.active {
    background: #dffbef;
    color: #12201c;
  }

  .select-wrap {
    gap: 0.45rem;
    color: #71817c;
    font-size: 0.72rem;
  }

  .select-wrap select {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 0.42rem 1.6rem 0.42rem 0.58rem;
    background: #151e1c;
    color: #dce9e4;
    font: inherit;
    font-size: 0.76rem;
  }

  .credit-link {
    color: var(--mint-strong);
    font-size: 0.72rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .credit-link:hover,
  .credit-link:focus-visible { text-decoration: underline; }

  .phoneme-sections {
    display: grid;
    gap: 6.5rem;
  }

  .phoneme-section[hidden] { display: none; }

  .section-heading {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 420px);
    align-items: end;
    gap: 3rem;
    margin-bottom: 2rem;
  }

  .section-heading > div > p {
    margin-bottom: 0.65rem;
    color: var(--mint-strong);
    font: 600 0.68rem/1 var(--font-mono);
    letter-spacing: 0.15em;
  }

  .section-heading h2 {
    color: #edf8f3;
    font: 500 clamp(2.3rem, 4.5vw, 3.5rem)/1 var(--font-serif);
    letter-spacing: -0.035em;
  }

  .section-heading sup {
    margin-left: 0.4rem;
    color: #60716b;
    font: 400 0.8rem/1 var(--font-mono);
    vertical-align: top;
  }

  .section-description {
    padding-bottom: 0.15rem;
    color: var(--secondary);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .phoneme-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .phoneme-card {
    position: relative;
    min-height: 218px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
    padding: 1.2rem 1.25rem 1.15rem;
    border: 0;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .phoneme-card:hover,
  .phoneme-card:focus-visible,
  .phoneme-card.playing {
    z-index: 2;
    outline: none;
    background: var(--panel-high);
    box-shadow: inset 0 0 0 1px rgba(167, 243, 208, 0.3), 0 16px 40px rgba(0, 0, 0, 0.2);
  }

  .phoneme-card:hover { transform: translateY(-3px); }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .family {
    color: #687a74;
    font: 500 0.65rem/1 var(--font-mono);
    letter-spacing: 0.06em;
  }

  .play-icon {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: #80918b;
    transition: all 180ms ease;
  }

  .play-icon svg { width: 14px; fill: currentColor; }

  .phoneme-card:hover .play-icon,
  .phoneme-card.playing .play-icon {
    border-color: var(--mint-strong);
    background: var(--mint-strong);
    color: #0b100f;
  }

  .ipa {
    margin: 1.2rem 0 0.8rem;
    color: #effaf5;
    font: 500 2.65rem/1 var(--font-serif);
    letter-spacing: -0.025em;
  }

  .example {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .word { color: #bdcbc6; font-size: 0.9rem; font-weight: 600; }
  .transcription { color: #61716c; font: 400 0.7rem/1 var(--font-mono); }

  .hint {
    margin-top: auto;
    padding-top: 0.9rem;
    color: #73847e;
    font-size: 0.72rem;
  }

  .sound-bars {
    position: absolute;
    right: 1.2rem;
    bottom: 1.25rem;
    height: 15px;
    display: flex;
    align-items: center;
    gap: 2px;
    opacity: 0;
  }

  .sound-bars i {
    width: 2px;
    height: 4px;
    border-radius: 2px;
    background: var(--mint-strong);
  }

  .playing .sound-bars { opacity: 1; }
  .playing .sound-bars i:nth-child(1) { animation: soundbar 500ms ease-in-out infinite alternate; }
  .playing .sound-bars i:nth-child(2) { animation: soundbar 420ms 80ms ease-in-out infinite alternate; }
  .playing .sound-bars i:nth-child(3) { animation: soundbar 580ms 30ms ease-in-out infinite alternate; }
  .playing .sound-bars i:nth-child(4) { animation: soundbar 460ms 120ms ease-in-out infinite alternate; }

  @keyframes soundbar { to { height: 15px; } }

  .learning-note {
    display: grid;
    grid-template-columns: 140px minmax(0, 660px);
    gap: 2rem;
    margin-top: 7rem;
    padding: 2.2rem;
    border: 1px solid var(--line);
    background: linear-gradient(120deg, rgba(88, 214, 167, 0.08), transparent 65%);
  }

  .note-number {
    color: var(--mint-strong);
    font: 600 0.68rem/1 var(--font-mono);
    letter-spacing: 0.12em;
  }

  .learning-note h2 {
    margin-bottom: 0.7rem;
    color: #edf8f3;
    font: 500 1.55rem/1.25 var(--font-serif);
  }

  .learning-note p { color: var(--secondary); font-size: 0.88rem; line-height: 1.8; }

  @media (max-width: 980px) {
    .phonetics-hero { grid-template-columns: 1fr 280px; gap: 2rem; }
    .sound-orbit { width: 250px; }
    .orbit-symbol--one { top: 8px; left: 35px; }
    .orbit-symbol--two { top: 62px; }
    .orbit-symbol--three { left: 55px; }
    .practice-panel { align-items: flex-start; }
    .practice-controls { flex-wrap: wrap; justify-content: flex-end; }
    .phoneme-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (max-width: 720px) {
    .phonetics-page { width: min(100% - 2rem, 1180px); padding-top: 7.5rem; }
    .phonetics-hero { min-height: 0; grid-template-columns: 1fr; padding-bottom: 4rem; }
